# Copy this file to android/key.properties and fill in your own values.
# The real key.properties is git-ignored and must never be committed.
#
# Generate a keystore once with:
#   keytool -genkey -v -keystore ~/upload-keystore.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias upload
#
# Then reference it here:
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=CHANGE_ME_TO_ABSOLUTE_OR_RELATIVE_PATH_TO_KEYSTORE