{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "dart": {
      "command": ["dart", "format", "$FILE"],
      "extensions": [".dart"]
    }
  },
  "lsp": {
    "dart": {
      "command": ["dart", "language-server", "--protocol=lsp"],
      "extensions": [".dart"]
    }
  },
  "agent": {
    "build": {
      "description": "Default agent for the Note-Alarm Flutter app. Runs the Flutter toolchain and edits Dart code.",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "description": "Read-only planning and analysis agent. Use for code review, architecture analysis, and planning.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "permission": {
    "default": "allow"
  }
}
